# ==============================
# Rhythm 2000s .gitignore
# Stack: TypeScript + PixiJS + Vite+, dependencies via pnpm (doc/decisions/0001-tech-stack.md)
# ==============================

# ---------- Operating systems ----------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------- Editors / IDEs ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ---------- Environment and secrets ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Logs and temporary files ----------
logs/
*.log
*.tmp
*.temp
tmp/
temp/

# ---------- Node / Vite ----------
# pnpm-lock.yaml is committed; don't ignore it
*.local
vite.config.*.timestamp-*
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/*
!.yarn/patches
!.yarn/releases
.vite/
.cache/
.parcel-cache/
.turbo/
.eslintcache
*.tsbuildinfo
coverage/

# ---------- Build output ----------
dist/
build/
out/
release/

# ---------- Audio / art project intermediates ----------
# Commit only exported assets; use Git LFS if project files need versioning
*.reapeaks
*.bak
*.autosave

# ---------- Local AI assistant settings ----------
# Shared project memory in memory/ is committed; these are personal local settings
.claude/settings.local.json
# Snapshots and scratch scripts from the Playwright MCP browser tool
.playwright-mcp/
