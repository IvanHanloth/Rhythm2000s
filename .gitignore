# ==============================
# rhythm2000s .gitignore
# 技术栈：TypeScript + PixiJS + Vite+，pnpm 管理依赖（见 doc/decisions/0001-技术栈选型.md）
# ==============================

# ---------- 操作系统 ----------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ---------- 环境变量与密钥 ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- 日志与临时文件 ----------
logs/
*.log
*.tmp
*.temp
tmp/
temp/

# ---------- Node / Vite ----------
# pnpm-lock.yaml 需要提交，不要忽略
*.local
vite.config.*.timestamp-*
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/*
!.yarn/patches
!.yarn/releases
.vite/
.cache/
.parcel-cache/
.turbo/
.eslintcache
*.tsbuildinfo
coverage/

# ---------- 构建产物 ----------
dist/
build/
out/
release/

# ---------- 音频/美术工程的中间文件 ----------
# 只提交导出的最终素材；工程源文件如需版本管理，建议改用 Git LFS
*.reapeaks
*.bak
*.autosave

# ---------- AI 助手本地配置 ----------
# 共享的项目记忆在 memory/ 中，需要提交；以下是个人本地配置
.claude/settings.local.json
# Playwright MCP 浏览器工具的快照和临时脚本
.playwright-mcp/

# ---------- 原版系统素材（仅本地参考，见 assets/README.md） ----------
assets/reference/
# 仅限个人使用授权的字体：不能在公开仓库里分发，各自下载到本地（见 assets/README.md）
assets/fonts/pp-neuebit/
